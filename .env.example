# Copy this file to .env and fill in the secret values. .env is git-ignored.
# Grouped by service. Image tags are pinned per service (never `latest`).
# Each service receives only the variables listed under it.
# The non-secret values below are ready to use: the image tags point at the
# currently published versions and let `docker compose up` run as is. The
# `replace-me` entries are secrets and MUST be set before `docker compose up`.

# ---- Image tags (pinned to the currently published versions; never `latest`.
# ---- Bump to a newer published build by setting the new sha-<short> or semver) ----
BANCO_DE_DADOS_TAG=sha-ca77592
BACK_END_TAG=sha-29845ac
FRONT_END_TAG=sha-9a2c529
# Official image, pin an exact version.
REDIS_TAG=7.4.2

# ---- banco-de-dados (mysql:8.4) ----
MYSQL_ROOT_PASSWORD=replace-me-root-password
MYSQL_DATABASE=doce_terapia
MYSQL_USER=doceterapia
MYSQL_PASSWORD=replace-me-db-password

# ---- back-end ----
SPRING_PROFILES_ACTIVE=prod
# JDBC URL pointing at the banco-de-dados service on the internal network.
# allowPublicKeyRetrieval=true is safe here because the database lives on the
# Docker-internal network `interna` (internal: true), never exposed to the
# host nor given any outbound reachability.
DB_URL=jdbc:mysql://banco-de-dados:3306/doce_terapia?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# Usually the same as MYSQL_USER / MYSQL_PASSWORD above.
DB_USERNAME=doceterapia
DB_PASSWORD=replace-me-db-password
# HMAC-SHA256 signing key, Base64-encoded, at least 32 random bytes. No
# default: the app fails to start without it. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=replace-me-jwt-secret-base64

# ---- front-end ----
# Upstream the nginx /api proxy forwards to. In compose, the back-end service.
API_UPSTREAM=http://back-end:8080
# Host port for the web app. Defaults to 3000 in the base compose; set only to
# override (e.g. to free 3000 on a shared machine).
FRONTEND_HOST_PORT=3000

# ---- redis ----
REDIS_PASSWORD=replace-me

# ---- Local override only (compose.local.yml) -------------------------------
# Used solely by compose.local.yml; the base compose ignores these.
# Host port for the back-end (Swagger UI). Has a default, override to free 8080.
BACK_END_HOST_PORT=8080
# ngrok tunnel (profile `tunnel`) for Cloud API webhook tests.
NGROK_AUTHTOKEN=replace-me
# Host:port the tunnel forwards to (the orchestrator webhook). Not verifiable
# until the orchestrator service exists.
NGROK_UPSTREAM=orquestrador:8000
# ngrok local inspection UI port. Has a default.
NGROK_WEB_PORT=4040
# Pinned ngrok image tag.
NGROK_TAG=3.23.3

# ---- Assistant services (orquestrador, adaptador-baileys) ------------------
# Added by a later task. Their variables will be grouped here when their
# images exist. Intentionally empty for now.
