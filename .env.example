# Copy this file to .env and fill in the secret values. .env is git-ignored.
# Grouped by service. Image tags are pinned per service (never `latest`).
# Each service receives only the variables listed under it.
# The non-secret values below are ready to use: the image tags point at the
# currently published versions and let `docker compose up` run as is. The
# `replace-me` entries are secrets and MUST be set before `docker compose up`.

# ---- Image tags (pinned to the currently published versions; never `latest`.
# ---- Bump to a newer published build by setting the new sha-<short> or semver) ----
BANCO_DE_DADOS_TAG=sha-be14efe
BACK_END_TAG=sha-7b520f8
FRONT_END_TAG=sha-3573a40
# Official image, pin an exact version.
REDIS_TAG=7.4.2
ORQUESTRADOR_TAG=sha-423bcd5
ADAPTADOR_BAILEYS_TAG=sha-4dbad18

# ---- banco-de-dados (mysql:8.4) ----
MYSQL_ROOT_PASSWORD=replace-me-root-password
MYSQL_DATABASE=doce_terapia
MYSQL_USER=doceterapia
MYSQL_PASSWORD=replace-me-db-password

# ---- back-end ----
SPRING_PROFILES_ACTIVE=prod
# JDBC URL pointing at the banco-de-dados service on the internal network.
# allowPublicKeyRetrieval=true is safe here because the database lives on the
# Docker-internal network `interna` (internal: true), never exposed to the
# host nor given any outbound reachability.
DB_URL=jdbc:mysql://banco-de-dados:3306/doce_terapia?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# Usually the same as MYSQL_USER / MYSQL_PASSWORD above.
DB_USERNAME=doceterapia
DB_PASSWORD=replace-me-db-password
# HMAC-SHA256 signing key, Base64-encoded, at least 32 random bytes. No
# default: the app fails to start without it. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=replace-me-jwt-secret-base64

# ---- front-end ----
# Upstream the nginx /api proxy forwards to. In compose, the back-end service.
API_UPSTREAM=http://back-end:8080
# Host port for the web app. Defaults to 3000 in the base compose; set only to
# override (e.g. to free 3000 on a shared machine).
FRONTEND_HOST_PORT=3000

# ---- redis ----
REDIS_PASSWORD=replace-me

# ---- Local override only (compose.local.yml) -------------------------------
# Used solely by compose.local.yml; the base compose ignores these.
# Host port for the back-end (Swagger UI). Has a default, override to free 8080.
BACK_END_HOST_PORT=8080
# Address the back-end port is bound to on the host. 127.0.0.1 (default) keeps
# it reachable only from this machine. Set 0.0.0.0 to reach it from other hosts,
# e.g. on a provisioned server: the API has no authentication on its business
# routes, so also restrict access with a firewall or security group.
BACK_END_HOST_BIND=127.0.0.1
# ngrok tunnel (profile `tunnel`) for Cloud API webhook tests.
NGROK_AUTHTOKEN=replace-me
# Host:port the tunnel forwards to. Defaults to the orchestrator webhook
# (orquestrador:8000); set only to tunnel somewhere else.
NGROK_UPSTREAM=orquestrador:8000
# ngrok local inspection UI port. Has a default.
NGROK_WEB_PORT=4040
# Address the inspection UI is bound to. 127.0.0.1 (default) keeps it local.
# Set 0.0.0.0 to open it from other hosts; the UI has no authentication and
# shows request bodies and signatures, so restrict access with a firewall or
# security group first.
NGROK_WEB_BIND=127.0.0.1
# Pinned ngrok image tag.
NGROK_TAG=3.23.3

# ---- orquestrador ----------------------------------------------------------
# WhatsApp channel: `baileys` (default) or `cloud_api`.
CHANNEL=baileys
# Authorized sender (the beneficiaria), E.164 format.
BENEFICIARIA_TELEFONE=+5511999999999
# Core API base URL on the internal network.
CORE_BASE_URL=http://back-end:8080
# Redis connection URL. Must carry the same password as REDIS_PASSWORD and
# point at the `redis` service. Kept separate from the back-end vars so no
# other service receives it.
ORQUESTRADOR_REDIS_URL=redis://:replace-me@redis:6379/0
# Conversation inactivity TTL (minutes).
CONV_TTL_MIN=30
# Allowed free-text adjustments per purchase.
MAX_AJUSTES=2
# Retry worker policy.
RETRY_MAX_TENTATIVAS=6
RETRY_BASE_S=2
RETRY_CAP_S=300
# Time zone.
TZ=America/Sao_Paulo
# Baileys channel: adapter base URL and secrets (secrets: no real value here).
ADAPTER_URL=http://adaptador-baileys:8080
ADAPTER_SECRET=replace-me
WEBHOOK_SECRET=replace-me
# Cloud API channel (used only when CHANNEL=cloud_api).
CLOUD_API_PHONE_ID=replace-me
CLOUD_API_TOKEN=replace-me
CLOUD_API_APP_SECRET=replace-me
CLOUD_API_VERIFY_TOKEN=replace-me
CLOUD_API_GRAPH_VERSION=v23.0
# LLM provider (purchase extraction).
LLM_PROVIDER=gemini
GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-2.0-flash

# ---- adaptador-baileys (profile `baileys`) ---------------------------------
# JID of the dedicated WhatsApp group; only its messages are processed.
GRUPO_JID=000000000000000000@g.us
# Orchestrator webhook the adapter forwards inbound events to. The orchestrator
# exposes the inbound route at /webhook on port 8000. ADAPTER_SECRET and
# WEBHOOK_SECRET are shared with the orquestrador group above.
WEBHOOK_URL=http://orquestrador:8000/webhook
# Session directory inside the container; matches the mounted named volume.
BAILEYS_SESSION_DIR=/data/session
# pino log level.
BAILEYS_LOG_LEVEL=info
# Opt-in group discovery. Set true once, start the adapter, read the logged
# group ids and names, copy the dedicated group's id into GRUPO_JID, then set
# back to false. The log exposes group names, so keep those logs private.
DISCOVER_GROUPS=false
